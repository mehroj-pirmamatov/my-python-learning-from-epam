
def create_user_profile(username, **details):
    """
    Create and return a user profile with additional details.
    """
    if not username.strip():
        raise ValueError("Username cannot be empty.")

    allowed_fields = {"age", "job", "country", "email"}

    invalid_fields = set(details) - allowed_fields
    if invalid_fields:
        raise ValueError(
            f"Unsupported fields: {', '.join(sorted(invalid_fields))}"
        )

    profile = {
        "username": username,
        **details
    }

    return profile


user = create_user_profile(
    "mehroj_dev",
    age=21,
    job="Python Developer",
    country="Uzbekistan",
    email="mehroj@example.com"
)

for field, value in user.items():
    print(f"{field.title()}: {value}")
