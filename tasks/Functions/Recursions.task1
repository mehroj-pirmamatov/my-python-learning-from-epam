def flatten_nested_list(data: list) -> list:
    result = []
    for item in data:
        if isinstance(item, list):
            result.extend(flatten_nested_list(item))
        else:
            result.append(item)
    return result


def quicksort(arr: list) -> list:
    if len(arr) <= 1:
        return arr
    pivot = arr[len(arr) // 2]
    left = [x for x in arr if x < pivot]
    middle = [x for x in arr if x == pivot]
    right = [x for x in arr if x > pivot]
    return quicksort(left) + middle + quicksort(right)


def solve_n_queens(n: int) -> list:
    def backtrack(r: int, cols: set, pos_diag: set, neg_diag: set, board: list, res: list):
        if r == n:
            res.append(["".join(row) for row in board])
            return
        for c in range(n):
            if c in cols or (r + c) in pos_diag or (r - c) in neg_diag:
                continue
            cols.add(c)
            pos_diag.add(r + c)
            neg_diag.add(r - c)
            board[r][c] = "Q"

            backtrack(r + 1, cols, pos_diag, neg_diag, board, res)

            cols.remove(c)
            pos_diag.remove(r + c)
            neg_diag.remove(r - c)
            board[r][c] = "."

    results = []
    empty_board = [["."] * n for _ in range(n)]
    backtrack(0, set(), set(), set(), empty_board, results)
    return results


if __name__ == "__main__":
    nested_data = [1, [2, [3, 4], 5], 6, [7, [8]]]
    print("1. Flatten list:", flatten_nested_list(nested_data))

    unsorted_list = [29, 10, 14, 37, 14, 20, 7, 45]
    print("2. QuickSort:", quicksort(unsorted_list))

    queens_solutions = solve_n_queens(4)
    print("3. N-Queens (4x4) yechimlar soni:", len(queens_solutions))
